{
  "name": "lingua-desktop",
  "version": "0.2.0",
  "private": true,
  "author": "NEXUS",
  "description": "NEXUS 本地工作台",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "start": "pnpm build && electron .",
    "probe": "pnpm build && node scripts/probe.mjs",
    "test": "pnpm build && node --test 'dist/**/*.test.js'",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:manifest": "node scripts/write-runtime-manifest.mjs runtime",
    "dist:mac": "node scripts/release-mac.mjs",
    "dist:mac:friends": "NEXUS_LOCAL_SIGNING=adhoc node scripts/build-local-mac.mjs",
    "dist:mac:local": "node scripts/build-local-mac.mjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@types/node": "^22.10.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
