# Service credentials are configured by each user in Settings.
# Never copy a personal .env, vault.key or runtime database into a public release.
LINGUA_RUNTIME_PROFILE=desktop
LINGUA_DATABASE_URL=sqlite+aiosqlite:///../data/desktop/nexus.sqlite3
LINGUA_MEDIA_ROOT=../data/desktop/media
LINGUA_GRAMMAR_DOCS_ROOT=../data/desktop/grammar
LINGUA_CONFIG_KEY=
LINGUA_OPENAI_REALTIME_KEY=
LINGUA_MCP_TOKEN=
